{
  "name": "wesfin",
  "version": "1.0.0",
  "description": "WESFIN - controle financeiro simples com login Google e Supabase",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
