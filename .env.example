# Porta da API
PORT=3000

# Supabase (Project Settings > API Keys)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a chave SECRETA (sb_secret_... ou a antiga service_role), NÃO a publishable (sb_publishable_...).
# Ela fica SOMENTE no backend, nunca no app.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# Google Cloud > Clients > Client ID do tipo Web (termina em .apps.googleusercontent.com)
GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# Opcional: Client IDs Android/iOS aceitos no login do app nativo, separados por vírgula
GOOGLE_CLIENT_IDS_NATIVOS=

# Origens liberadas para chamar a API com cookie (Expo web em desenvolvimento)
CORS_ORIGENS=http://localhost:8081

# Fuso horário usado para vencimentos de contas mensais (Brasília = -03:00)
TZ_OFFSET=-03:00
